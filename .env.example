# Local Ollama generation.
RAG_ANSWER_PROVIDER=google
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash


# Unload models 10s after last use (per-request). For a global max loaded
# models cap, set OLLAMA_MAX_LOADED_MODELS=2 where `ollama serve` runs.
OLLAMA_KEEP_ALIVE=10s

# Docker host ports. Kept separate from the Chroma RAG stack.
RAG_API_CPU_PORT=9000
RAG_API_GPU0_PORT=9002
RAG_API_GPU1_PORT=9003
RAG_API_OLLAMA_CPU_PORT=11434
RAG_API_OLLAMA_GPU0_PORT=11435
RAG_API_OLLAMA_GPU1_PORT=11436
RAG_API_QDRANT_PORT=6333
RAG_API_REDIS_PORT=6379

# Local Ollama retrieval models.
RAG_LOCAL_OLLAMA_HOST=http://localhost:11434
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_MODEL=embeddinggemma:latest
RAG_ROUTER_OLLAMA_HOST=https://ollama.com
RAG_ROUTER_OLLAMA_API_KEY=
RAG_ROUTER_MODEL= gpt-oss:20b-cloud

RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_API_KEY=
RAG_COLLECTION_NAME=documents
RAG_REDIS_URL=redis://localhost:6379/0
RAG_CHAT_MEMORY_TTL_SECONDS=3600
RAG_CHAT_MEMORY_MAX_MESSAGES=20

RAG_TOP_K=5
RAG_FETCH_K=20
